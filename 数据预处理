#创建新特征值
df['total_force'] = df[['pressure1', 'pressure2', 'pressure3']].sum(axis=1)#总传感器值（实际力值）
df['force_diff'] = df['total_force'] - df['required_grip_force']#实际值与估计值差
for i in [1,2,3]:
    df[f's{i}_ratio'] = df[f'pressure{i}'] / df['total_force']#各传感器占比
