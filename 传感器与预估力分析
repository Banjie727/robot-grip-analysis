import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from scipy.stats import ttest_ind, levene
plt.rcParams['font.sans-serif'] = ['Arial Unicode MS', 'SimHei', 'DejaVu Sans']
plt.rcParams['axes.unicode_minus'] = False
#对数据进行导入检查
df = pd.read_csv(r"D:\TEMP\archive\robot_grip.csv");
df.isnull().sum()#检查缺失值数量 没有
df.duplicated().sum()#检查重复行数量 没有
df = df[df['required_grip_force'] >=0]#去除无效值
df['grip_success'].value_counts(normalize=True)#统计成功与失败的占比  成功：0.71 失败：0.29
len(df)#剩余1963个值
#创建新特征值
df['total_force'] = df[['pressure1', 'pressure2', 'pressure3']].sum(axis=1)#总传感器值（实际力值）
df['force_diff'] = df['total_force'] - df['required_grip_force']#实际值与估计值差
for i in [1,2,3]:
    df[f's{i}_ratio'] = df[f'pressure{i}'] / df['total_force']#各传感器占比
#df.head()验证新特征值创建成功
#点1-传感器分配问题
df.groupby('grip_success')[['s1_ratio','s2_ratio','s3_ratio']].mean()#s2_ratio特殊
fail_df = df[df['grip_success'] == 0];
fail_df['s2_ratio'].describe()
for i in [0,1]:
    fail_df = df[df['grip_success'] == i]
    low_fail = fail_df[fail_df['s2_ratio'] < 0.23]
    high_fail = fail_df[fail_df['s2_ratio'] >0.42]
    print(f"{i}的总数:{len(fail_df)}\n"f"<0.23的数量是:{len(low_fail)},占比:{len(low_fail)/len(fail_df)*100:.2f}%\n"f">0.42的数量是:{len(high_fail)},占比:{len(high_fail)/len(fail_df)*100:.2f}%")
#不是传感器分配问题
#点2-预估力稳定性
df['weight_group'] = pd.cut(df['weight'], bins=range(0, 1001, 50))
df['size_group'] = pd.cut(df['size'], bins=range(0, 21, 5))
# 按重量+尺寸+纹理分组，计算每组预估力的标准差和样本数
group_stats = df.groupby(['weight_group', 'size_group', 'texture'])['required_grip_force'].agg(['std', 'count', 'mean'])
group_stats = group_stats.dropna()  # 去掉空组
group_stats = group_stats.sort_values('std', ascending=False)
group_stats.head(10)
#各组预估力标准差分布
plt.figure(figsize=(10, 5))
plt.hist(group_stats['std'], bins=30, color='steelblue', edgecolor='black')
plt.axvline(x=6, color='red', linestyle='--', label='波动阈值 std=6')
plt.xlabel('预估力标准差 (N)')
plt.ylabel('组数')
plt.title('各组内预估力的标准差分布')
plt.legend()
plt.savefig('std_distribution.png', dpi=150)
plt.show()
# 对比高波动组和低波动组的成功率
high_std_groups = group_stats[group_stats['std'] > 6].index.tolist()
df['is_high_variance'] = df.set_index(['weight_group', 'size_group', 'texture']).index.isin(high_std_groups)
df.groupby('is_high_variance')['grip_success'].mean()
#成功率差不多
# 按预估力分段统计成功率
df['force_bucket'] = pd.cut(df['required_grip_force'], bins=20)
force_analysis = df.groupby('force_bucket')['grip_success'].agg(['mean', 'count'])
force_analysis.columns = ['成功率', '样本数']
force_analysis.head(10)
# 发现临界值11N
low_force = df[df['required_grip_force'] < 11]
low_force['grip_success'].value_counts(normalize=True)
high_force = df[df['required_grip_force'] >= 11]
high_force['grip_success'].value_counts(normalize=True)
#实际力VS预估力散点图
plt.figure(figsize=(10, 6))
# 成功案例（绿色）
success = df[df['grip_success'] == 1]
plt.scatter(success['required_grip_force'], success['total_force'], 
            c='green', alpha=0.3, label='成功', s=10)
# 失败案例（红色）
fail = df[df['grip_success'] == 0]
plt.scatter(fail['required_grip_force'], fail['total_force'], 
            c='red', alpha=0.5, label='失败', s=10)
# 参考线：实际力 = 预估力
x_line = np.linspace(0, 35, 100)
plt.plot(x_line, x_line, 'k--', linewidth=1, label='实际力=预估力')
# 11N临界线
plt.axvline(x=11, color='blue', linestyle='--', linewidth=1.5, label='11N临界值')
plt.xlabel('预估力 required_grip_force (N)')
plt.ylabel('实际力 total_force (N)')
plt.title('实际力 VS 预估力 (按成功/失败着色)')
plt.legend()
plt.savefig('force_scatter.png', dpi=150)
plt.show()
#低预估力组
low_force_df = df[df['required_grip_force'] < 11]
low_force_df.groupby(['weight_group', 'size_group', 'texture']).size().sort_values(ascending=False).head(10)
# 定义异常低估：预估力<11N，但重量>300g 或 尺寸>10mm
anomaly_low = df[(df['required_grip_force'] < 11) & ((df['weight'] > 300) | (df['size'] > 10))]
print(f"异常低估样本数: {len(anomaly_low)}")
print(f"异常低估样本占比: {len(anomaly_low)/len(df)*100:.2f}%")
print(f"异常低估样本的失败率: {anomaly_low['grip_success'].mean():.2%}")
# 按重量区间统计异常低估的数量
anomaly_low['weight_group'] = pd.cut(anomaly_low['weight'], bins=[0,100,200,300,500,800,1000])
anomaly_low.groupby('weight_group').size()
#高预估力组
high_force = df[df['required_grip_force'] >= 11]
# 高预估力组中的失败案例
high_fail = high_force[high_force['grip_success'] == 0]
print(f"高预估力组中失败案例数: {len(high_fail)}")
print(f"高预估力组失败率: {len(high_fail)/len(high_force)*100:.2f}%")
# 对比成功和失败的实际力差距
high_force.groupby('grip_success')['force_diff'].describe()
# 看这些失败案例的特征
high_fail[['weight', 'size', 'texture', 'required_grip_force', 'total_force', 'force_diff']].head(10)
#高预估力组的四个案例
high_force = df[df['required_grip_force'] >= 11]
high_fail = high_force[high_force['grip_success'] == 0]
plt.figure(figsize=(10, 5))
# 绘制所有高预估力组样本（灰色背景）
plt.scatter(high_force['required_grip_force'], high_force['total_force'], 
            c='lightgray', alpha=0.5, label='成功案例', s=15)
# 高亮4个失败案例
plt.scatter(high_fail['required_grip_force'], high_fail['total_force'], 
            c='red', s=100, marker='o', edgecolors='black', label='失败案例 (仅4个)')
# 添加标注
for idx, row in high_fail.iterrows():
    plt.annotate(f"{row['weight']}g,{row['size']}mm", 
                 (row['required_grip_force'], row['total_force']),
                 xytext=(5, 10), textcoords='offset points', fontsize=8)
plt.axvline(x=11, color='blue', linestyle='--', label='11N临界值')
plt.xlabel('预估力 required_grip_force (N)')
plt.ylabel('实际力 total_force (N)')
plt.title('高预估力组 (≥11N) 中的失败案例')
plt.legend()
plt.savefig('high_force_failures.png', dpi=150)
plt.show()
